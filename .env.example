# 复制成 .env 后用于本地开发。.env 已在 .gitignore 里，不要提交。
APP_ENV=development

# 本地开发直连的库（用 docker run 起一个 MySQL，或直接用 sqlite）
# DATABASE_URL=sqlite:///dev.db
DATABASE_URL=mysql+pymysql://root:devpass@127.0.0.1:3306/english_tracker?charset=utf8mb4

AUTO_CREATE_TABLES=1

# 本地调试用的假身份。只在 loopback 请求且非生产环境生效。
DEV_OPENID=dev-user-001

# 本地没有云托管的开放接口服务，用它跳过内容检测。
# 生产环境设成 off 会导致容器拒绝启动。
MODERATION_MODE=off

# 对象存储（只有删除文件时才用到）。本地留空即可，删除会被跳过并记日志。
COS_BUCKET=
COS_REGION=ap-shanghai
# 如果开放接口服务的临时密钥不够用，就配一对 CAM 子账号密钥
COS_SECRET_ID=
COS_SECRET_KEY=
